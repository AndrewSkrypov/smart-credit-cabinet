# Copy to .env to override the defaults of docker-compose.yml. Every value has a working
# default for a local run; change JWT_SECRET and the database password anywhere else.
GATEWAY_PORT=8080
POSTGRES_USER=cabinet
POSTGRES_PASSWORD=cabinet
# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes+
# false: the published demo accounts are created blocked
DEMO_ACCOUNTS=true
# Key the cabinet's services use to call the simulated external systems
SIM_API_KEY=dev-sim-api-key
# false: the simulators' control panel cannot switch sources off
SIM_CONTROL_ENABLED=true
