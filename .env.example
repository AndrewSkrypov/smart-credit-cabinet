# Copy to .env to override the defaults of docker-compose.yml. Every value has a working
# default for a local run; change JWT_SECRET and the database password anywhere else.
GATEWAY_PORT=8080
POSTGRES_USER=cabinet
POSTGRES_PASSWORD=cabinet
# These six local-only credentials are distinct; production configure.py generates secrets.
IDENTITY_DB_PASSWORD=dev-identity-runtime-password
CREDIT_DB_PASSWORD=dev-credit-runtime-password
ENGAGEMENT_DB_PASSWORD=dev-engagement-runtime-password
IDENTITY_MIGRATION_PASSWORD=dev-identity-owner-password
CREDIT_MIGRATION_PASSWORD=dev-credit-owner-password
ENGAGEMENT_MIGRATION_PASSWORD=dev-engagement-owner-password
# At least 32 bytes: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes+
VALKEY_PASSWORD=dev-valkey-password-change-before-deployment
# Separate secret for one-time links; preserve privately with recovery configuration.
IDENTITY_LINK_KEY=dev-identity-links-change-before-deployment-48bytes
IDENTITY_LINK_KEY_VERSION=1
# false: the published demo accounts are created blocked
DEMO_ACCOUNTS=true
# Key the cabinet's services use to call the simulated external systems
SIM_API_KEY=dev-sim-api-key
# false: the simulators' control panel cannot switch sources off
SIM_CONTROL_ENABLED=true
# Pipeline timings (ISO 8601 durations). Demo defaults; production: P14D, P5D, PT1H
INFO_REQUEST_TTL=PT30M
OFFER_TTL=PT30M
SOURCE_TIMEOUT=PT3M
# Existing assistant default; check its license before use. Verified evaluation override: docs/assistant-eval.md.
ASSISTANT_MODEL=qwen2.5:3b
# Optional override: explicitly empty disables every model probe/chat (rules-only evaluation).
# OLLAMA_URL=
# auto discovers the optional mail profile; off disables it explicitly, on uses configured SMTP.
MAIL_MODE=auto
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=cabinet@demo.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false
PUBLIC_CABINET_URL=http://localhost:8080
MAILPIT_PORT=8025
