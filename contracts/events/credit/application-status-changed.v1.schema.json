{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApplicationStatusChanged.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "applicationId", "applicationVersion", "status", "occurredAt"],
  "properties": {
    "eventId": {
      "$ref": "#/$defs/uuid",
      "description": "ID of the application journal entry for the status transition."
    },
    "applicationId": {
      "$ref": "#/$defs/uuid",
      "description": "Credit application ID, also carried as the Kafka record key."
    },
    "applicationVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807,
      "description": "Persisted optimistic lock version returned after saveAndFlush."
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_CLIENT_CONFIRMATION",
        "SUBMITTED",
        "INFO_REQUESTED",
        "ENRICHMENT",
        "SCORING",
        "MANUAL_REVIEW",
        "OFFER_ISSUED",
        "SIGNING",
        "DISBURSING",
        "DISBURSED",
        "REJECTED",
        "WITHDRAWN",
        "CLOSED"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$",
      "description": "Journal entry time in UTC in the Java Instant wire format."
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
