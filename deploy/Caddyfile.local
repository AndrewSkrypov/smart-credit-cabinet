{
    local_certs
    skip_install_trust
    admin off
}

localhost {
    tls internal
    encode zstd gzip
    @private path /sim /sim/* /swagger /swagger/* /v3/api-docs /v3/api-docs/* /actuator /actuator/* /internal /internal/* /ext /ext/*
    respond @private 404
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy gateway:80
}
