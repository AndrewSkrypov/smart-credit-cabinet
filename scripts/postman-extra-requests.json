[
  {
    "name": "82. Заявка для проверки переписки",
    "request": {
      "method": "POST",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{manualClientToken}}",
            "type": "string"
          }
        ]
      },
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "url": "{{baseUrl}}/applications",
      "body": {
        "mode": "raw",
        "raw": "{\"productCode\": \"WORKING_CAPITAL\", \"purpose\": \"WORKING_CAPITAL\", \"amount\": 3000000, \"termMonths\": 24, \"declaredRevenue12m\": 15000000, \"bureauConsent\": true}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "event": [
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
            "pm.collectionVariables.set('chatApplication',pm.response.json().id);"
          ]
        }
      }
    ]
  },
