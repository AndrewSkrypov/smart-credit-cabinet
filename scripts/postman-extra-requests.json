  {
    "name": "84. Ожидание готовности переписки",
    "request": {
      "method": "GET",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{manualClientToken}}",
            "type": "string"
          }
        ]
      },
      "header": [],
      "url": "{{baseUrl}}/applications/{{chatApplication}}"
    },
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (!pm.collectionVariables.get('chat_deadline')) pm.collectionVariables.set('chat_deadline',Date.now()+90000);"
          ]
        }
      },
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
            "const app=pm.response.json();",
            "if (app.status !== 'MANUAL_REVIEW' && Date.now() < Number(pm.collectionVariables.get('chat_deadline'))) {",
            "  pm.test(\"Допустимый промежуточный статус\",()=>pm.expect(['SUBMITTED','ENRICHMENT','SCORING','DISBURSING']).to.include(app.status));",
            "  pm.execution.setNextRequest(pm.info.requestName);",
            "  setTimeout(()=>{},500);",
            "} else {",
            "  pm.collectionVariables.unset('chat_deadline');",
            "  pm.test(\"Достигнут MANUAL_REVIEW\",()=>pm.expect(app.status).to.equal('MANUAL_REVIEW'));",
            "}",
            "if (pm.response.json().status==='MANUAL_REVIEW') pm.collectionVariables.set('chatBefore',JSON.stringify(pm.response.json()));"
          ]
        }
      }
    ]
  },
