        }
      }
    },
    "event": [
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
          ]
        }
      }
    ]
  },
  {
    "name": "104. Закрытая заявка только для чтения",
    "request": {
      "method": "POST",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{manualClientToken}}",
            "type": "string"
          }
        ]
      },
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "url": "{{baseUrl}}/applications/{{chatApplication}}/messages",
      "body": {
        "mode": "raw",
        "raw": "{\"text\": \"После закрытия\"}",
        "options": {
          "raw": {
            "language": "json"
          }
        }
      }
    },
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
          ]
        }
      },
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"HTTP 409\",()=>pm.response.to.have.status(409));"
          ]
        }
      }
    ]
  },
  {
