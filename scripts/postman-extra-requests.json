          {
            "key": "token",
            "value": "{{manualClientToken}}",
            "type": "string"
          }
        ]
      },
      "header": [],
      "url": "{{baseUrl}}/applications/{{chatApplication}}/messages"
    },
    "event": [
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
            "pm.test('История сохранена, запись запрещена',()=>{pm.expect(pm.response.json().messages).to.have.length(3);pm.expect(pm.response.json().writable).to.equal(false);});"
          ]
        }
